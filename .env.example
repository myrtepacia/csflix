# Where the site is opened
APP_URL=http://localhost/csflix
# true shows full error messages (only while developing)
APP_DEBUG=false

# Database (Docker replaces DB_HOST with its own: htdocs/docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=csflix
DB_USER=root
DB_PASS=

# PayMongo: test keys (sk_test_, pk_test_) dili mo kuha og real money.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Emails (receipts, password reset) sent by Resend.
RESEND_API_KEY=
MAIL_FROM="CSFlix Cinema <onboarding@resend.dev>"
SUPPORT_EMAIL=
